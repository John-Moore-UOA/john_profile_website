---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const all = (await getCollection('courses')).sort((a, b) => a.data.code.localeCompare(b.data.code));
  return all.map((c, i) => ({ params: { slug: c.id }, props: { c, next: all[(i + 1) % all.length] } }));
}
const { c, next } = Astro.props;
const d = c.data;
const { Content } = await render(c);

// The course body follows a fixed shape (Overview / Topics covered / Skills and tools / Assessment),
// so it is parsed into structured parts and laid out as an overview rather than an article.
const inline = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '$1').replace(/`(.+?)`/g, '$1').trim();
const sections = new Map<string, string>();
(c.body ?? '').replace(/<!--[\s\S]*?-->/g, '').split(/^## /m).slice(1).forEach((chunk) => {
  const nl = chunk.indexOf('\n');
  sections.set(chunk.slice(0, nl).trim().toLowerCase(), chunk.slice(nl + 1).trim());
});
const overview = (sections.get('overview') ?? '').split(/\n\s*\n/).map(inline).filter(Boolean);
const topics = (sections.get('topics covered') ?? '').split(/^### /m).slice(1).map((g) => {
  const [head, ...rest] = g.split('\n');
  return { title: inline(head), items: rest.filter((l) => /^\s*[-*] /.test(l)).map((l) => inline(l.replace(/^\s*[-*] /, ''))) };
}).filter((g) => g.items.length);
const skills = (sections.get('skills and tools') ?? '').replace(/^[-*] /gm, '').split(/,|\n/).map(inline).filter(Boolean);
const assessment = (sections.get('assessment') ?? '').split('\n').filter((l) => /^\s*[-*] /.test(l)).map((l) => inline(l.replace(/^\s*[-*] /, '')));
const structured = topics.length > 0;
---
<Base title={`${d.code} ${d.name}`} description={d.desc}>
  <article class="page">
    <header class="page-head field">
      <div class="wrap head">
        <a class="back" href="/#courses"><Icon name="back" />All courses</a>
        <p class="code mono">{d.code}</p>
        <h1>{d.name}</h1>
        <p class="sum">{d.desc}</p>
        <dl class="facts">
          <div><dt>Taken</dt><dd class="mono">{d.term}</dd></div>
          <div><dt>Area</dt><dd>{d.area}</dd></div>
          <div><dt>Degree</dt><dd>BE(Hons) Software Engineering, University of Auckland</dd></div>
        </dl>
      </div>
    </header>

    <div class="wrap">
      {structured ? (
        <>
          {overview.length > 0 && (
            <section class="ov">
              <h2>Overview</h2>
              <div>{overview.map((p) => <p>{p}</p>)}</div>
            </section>
          )}

          <section class="topics">
            <h2>Topics covered</h2>
            <ol class="tgrid">
              {topics.map((t, i) => (
                <li>
                  <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{t.title}</h3>
                  <ul>{t.items.map((it) => <li>{it}</li>)}</ul>
                </li>
              ))}
            </ol>
          </section>

          <div class="foot-grid">
            {skills.length > 0 && (
              <section>
                <h2>Skills and tools</h2>
                <ul class="chips">{skills.map((s) => <li>{s}</li>)}</ul>
              </section>
            )}
            {assessment.length > 0 && (
              <section>
                <h2>Assessment</h2>
                <ul class="assess">{assessment.map((a) => <li>{a}</li>)}</ul>
              </section>
            )}
          </div>
        </>
      ) : (
        <div class="prose fallback"><Content /></div>
      )}

      <a class="next navy" href={`/courses/${next.id}/`}>
        <span class="nl">Next course</span>
        <span class="nt"><span class="mono">{next.data.code}</span> {next.data.name}</span>
        <Icon name="arrow" />
      </a>
    </div>
  </article>
</Base>

<style>
  .page { padding-bottom: clamp(4rem, 8vw, 6rem); }
  .head { display: grid; gap: 1.1rem; justify-items: start; }
  .code { margin-top: 1.5rem; font-size: 1.05rem; font-weight: 500; color: var(--bg); background: rgb(255 255 255 / .7); padding: .35rem .7rem; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(11 22 38 / .12); }
  .facts { justify-self: stretch; position: relative; display: flex; flex-wrap: wrap; gap: 1rem 3rem; margin: 1rem 0 0; padding-top: 1.3rem; border-top: 1px solid var(--rule); }
  .facts::before { content: ''; position: absolute; left: 0; top: -2px; width: 9rem; height: 3px; background: var(--bg); }
  .facts dt { font-size: .95rem; font-weight: 600; color: var(--ink-3); }
  .facts dd { margin: .2rem 0 0; color: var(--ink); font-weight: 500; }

  section { padding: 0; }
  h2 { font: 650 1.45rem/1.2 var(--sans); letter-spacing: -0.02em; }

  .ov { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 2rem; padding-top: 1.25rem; border-top: 2px solid var(--rule-strong); }
  .ov div { display: grid; gap: 1rem; max-width: 66ch; font-size: 1.15rem; line-height: 1.6; color: var(--ink); }

  .topics { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .topics > h2 { padding-top: 1.25rem; border-top: 2px solid var(--rule-strong); margin-bottom: 1.5rem; }
  .tgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.25rem; }
  .tgrid > li {
    display: grid; gap: .7rem; align-content: start; padding: 1.4rem 1.5rem 1.6rem; background: var(--surface); border-radius: var(--r-m);
    border-top: 3px solid var(--sky); box-shadow: inset 0 0 0 1px var(--sky-soft), var(--shadow-s);
  }
  .num { font-size: .85rem; color: var(--sky-ink); }
  .tgrid h3 { font: 650 1.15rem/1.3 var(--sans); letter-spacing: -0.01em; }
  .tgrid ul { margin: 0; padding-left: 1.1em; display: grid; gap: .4rem; color: var(--ink-2); font-size: 1rem; line-height: 1.5; }
  .tgrid ul li::marker { color: var(--sky-dim); }

  .foot-grid { margin-top: clamp(3rem, 6vw, 4.5rem); display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem 4rem; }
  .foot-grid section { padding-top: 1.25rem; border-top: 2px solid var(--rule-strong); }
  .chips { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .chips li { font-size: .95rem; font-weight: 500; color: var(--ink); padding: .45rem .8rem; border-radius: 999px; background: var(--sky-wash); box-shadow: inset 0 0 0 1px var(--sky-soft); }
  .assess { margin: 1rem 0 0; padding: 0; list-style: none; }
  .assess li { padding: .7rem 0; border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .assess li:first-child { padding-top: 0; }

  .fallback { margin-top: 1rem; }
  .next { margin-top: clamp(3.5rem, 7vw, 5rem); display: grid; grid-template-columns: 1fr auto; gap: .35rem 1.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--r-l); text-decoration: none; max-width: 44rem; box-shadow: var(--shadow); }
  .nl { font-size: .95rem; font-weight: 500; color: var(--ink-3); }
  .nt { font: 600 clamp(1.3rem, 2.6vw, 1.7rem)/1.2 var(--sans); letter-spacing: -0.02em; color: var(--ink); grid-column: 1; }
  .nt .mono { font-size: .8em; color: var(--sky); margin-right: .3rem; }
  .next :global(svg) { width: 1.3em; grid-row: 1 / span 2; grid-column: 2; align-self: center; color: var(--amber); transition: transform .3s var(--ease); }
  .next:hover :global(svg) { transform: translateX(5px); }

  @media (max-width: 760px) {
    .ov, .foot-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
