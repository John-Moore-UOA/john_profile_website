---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cats from '../components/Cats.astro';
import { site, experience, education, skills, publications, clients } from '../data/site';
import { CATEGORIES } from '../content.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
// The Masters panel shows one project in two parts; both are kept out of the index below.
const parts = site.masters.parts.map((part) => ({ ...part, entry: projects.find((p) => p.id === part.project)! }));
const rest = projects
  .filter((p) => !parts.some((part) => part.project === p.id))
  .sort((a, b) => Number(b.data.spotlight) - Number(a.data.spotlight));
const FOLD = 8; // compact rows shown before "And many more"
const leads = rest.filter((p) => p.data.spotlight).length;
const folded = Math.max(0, rest.length - leads - FOLD);
const usedCats = CATEGORIES.filter((c) => rest.some((p) => p.data.categories.includes(c)));

const AREAS = ['Computer Science', 'Software Engineering', 'Computer Systems', 'General Engineering'] as const;
const courses = await getCollection('courses');
const byArea = AREAS.map((area) => ({
  area,
  items: courses.filter((c) => c.data.area === area)
    .sort((a, b) => Number(b.data.highlight) - Number(a.data.highlight) || b.data.code.localeCompare(a.data.code)),
})).filter((g) => g.items.length);
---
<Base>
  <!-- Hero -->
  <section class="hero navy" data-scene="hero">
    <div class="wrap hero-grid">
      <h1>{site.name}</h1>
      <ul class="hero-lines">
        <li><strong>Master of Engineering candidate</strong>, Bioengineering</li>
        <li class="hero-sup">Supervised by Mark Billinghurst and Kunal Gupta</li>
        <li class="hero-orgs"><a href={site.lab.url} rel="noopener">{site.lab.name}</a><a href={site.abi.url} rel="noopener">{site.abi.name}</a></li>
        <li>BE(Hons) First Class, Software Engineering, {site.uni}</li>
      </ul>
      <p class="hero-lede">{site.lede}</p>
      <div class="hero-actions">
        <a class="btn" href="#projects">See current projects <Icon name="arrow" /></a>
        <a class="btn ghost" href="/cv/">View CV</a>
      </div>
      <dl class="hero-facts">
        <div><dt>Focus</dt><dd>AI agents · Empathic AI · Physiological sensing</dd></div>
        <div><dt>Open to</dt><dd>Research &amp; engineering roles in AI, XR and HCI</dd></div>
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="wrap">
      <header class="sec-head">
        <h2>Current projects</h2>
        <p>Research systems, study tools and side projects. Each one opens a design log with process notes, figures and outcomes.</p>
      </header>

      <article class="masters navy">
        <div class="masters-intro">
          <h3 class="masters-label">Masters project</h3>
          <div class="masters-text">
            <p class="masters-title">{site.masters.title}</p>
            <dl class="masters-meta">
              <div><dt>Where</dt><dd><a href={site.abi.url} rel="noopener">{site.abi.name}</a><br /><a href={site.lab.url} rel="noopener">{site.lab.name}</a></dd></div>
              <div><dt>Supervisors</dt><dd>Mark Billinghurst<br />Kunal Gupta</dd></div>
              <div><dt>Dates</dt><dd>{site.masters.when} (expected)<br />{site.masters.length}</dd></div>
            </dl>
          </div>
        </div>
        <div class="parts">
          {parts.map(({ entry, name, line, blurb, image, alt }) => (
            <a class="feature" href={`/projects/${entry.id}/`}>
              <div class="media">
                <img src={image ?? entry.data.image} alt={alt ?? entry.data.cover ?? ''} />
              </div>
              <div class="feature-body">
                <h4>{name}</h4>
                <p class="part-line">{line}</p>
                <p>{blurb}</p>
                <Cats list={entry.data.categories} />
                <span class="read">Read the design log <Icon name="arrow" /></span>
              </div>
            </a>
          ))}
        </div>
      </article>

      <div class="filters" role="group" aria-label="Filter projects by area" hidden>
        <button type="button" aria-pressed="true" data-cat="all">All</button>
        {usedCats.map((c) => <button type="button" aria-pressed="false" data-cat={c} data-c={c}>{c}</button>)}
      </div>

      <ul class="index">
        {rest.map((p, i) => {
          const lead = p.data.spotlight;
          return (
            <li data-cats={p.data.categories.join('|')} data-fold={!lead && i - leads >= FOLD ? '' : undefined} class:list={{ lead }}>
              <a class="row" href={`/projects/${p.id}/`}>
                <span class="mono yr">{p.data.year}</span>
                <div class="row-main">
                  <h3>{p.data.title}</h3>
                  {lead && <p class="row-sum">{p.data.summary}</p>}
                  <Cats list={p.data.categories} />
                  {lead && (
                    <dl class="row-meta">
                      <div><dt>Role</dt><dd>{p.data.role}</dd></div>
                      <div><dt>Built with</dt><dd>{p.data.stack.slice(0, 4).join(', ')}</dd></div>
                    </dl>
                  )}
                  {lead && <span class="more">Read the design log <Icon name="arrow" /></span>}
                </div>
                {!lead && <p class="row-sum">{p.data.summary}</p>}
                <div class="media">
                  {p.data.image
                    ? <img src={p.data.image} alt={p.data.cover ?? ''} loading="lazy" />
                    : <div class="ph slot-field" aria-hidden="true"><span class="slot-tag">Image to come</span><p>{p.data.cover}</p></div>}
                </div>
              </a>
            </li>
          );
        })}
        <li class="many">
          <h3>And many more</h3>
          <p>Smaller experiments, coursework and prototypes that sit alongside the work above.</p>
          <div class="many-actions">
            {folded > 0 && <button type="button" class="btn ghost show-all" hidden>Show {folded} more projects</button>}
            <a href={site.links.github} rel="noopener">Browse my GitHub</a>
          </div>
        </li>
      </ul>
      <p class="empty" hidden>No projects in this area yet.</p>
    </div>
  </section>

  <!-- Publications -->
  <section id="publications">
    <div class="wrap">
      <header class="sec-head"><h2>Publications</h2></header>
      <ol class="pubs">
        {publications.map((p) => (
          <li>
            <span class="mono pyear">{p.year}</span>
            <div>
              <h3><a href={p.url} rel="noopener">{p.title}</a></h3>
              <p class="venue">{p.venue} · {p.type}</p>
              <p class="authors">{p.authors.split(', ').map((a, i, arr) => <>{a === site.name ? <strong>{a}</strong> : a}{i < arr.length - 1 && ', '}</>)}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Working with people outside software -->
  <section id="clients" class="band">
    <div class="wrap">
      <header class="sec-head">
        <h2>Designing with people outside software</h2>
        <p>Some of my best work started with someone who knew their field far better than I did. My job was to listen, ask the awkward questions early, and turn what they needed into something they could actually use.</p>
      </header>
      <ul class="clients">
        {clients.map((c) => (
          <li>
            <a class="client" href={`/projects/${c.project}/`}>
              <h3 class="who">{c.who}</h3>
              <p class="ctitle">{c.title}</p>
              <ul class="points">{c.points.map((pt) => <li>{pt}</li>)}</ul>
              <span class="client-link">See the project <Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Courses -->
  <section id="courses">
    <div class="wrap">
      <header class="sec-head">
        <h2>Courses</h2>
        <p>Selected courses from my <strong>BE(Hons) in Software Engineering</strong> at the {site.uni} (2022 – 2025, First Class Honours). Open one to see what I built and how it connects to my research.</p>
      </header>
      <div class="areas">
        {byArea.map((g) => (
          <div class="area">
            <h3>{g.area}</h3>
            <ul>
              {g.items.map((c) => (
                <li>
                  <a href={`/courses/${c.id}/`}>
                    <span class="mono code">{c.data.code}</span>
                    <span class="cname">{c.data.name}</span>
                    <span class="mono term">{c.data.term}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="band">
    <div class="wrap">
      <header class="sec-head"><h2>Experience &amp; education</h2></header>
      <div class="xp-grid">
        <ol class="xp">
          {experience.map((x) => (
            <li>
              <p class="when">{x.when}</p>
              <h3>{x.title}</h3>
              <p class="org">{x.url ? <a href={x.url} rel="noopener">{x.org}</a> : x.org}</p>
              <p class="note">{x.note}</p>
            </li>
          ))}
        </ol>
        <div class="edu">
          <h3 class="col-title">Education</h3>
          {education.map((e) => (
            <div>
              <p class="when">{e.when}</p>
              <h4>{e.title}</h4>
              <p class="org">{e.org}</p>
              {e.note && <p class="note">{e.note}</p>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Toolkit (replaces About) -->
  <section id="toolkit">
    <div class="wrap">
      <header class="sec-head">
        <h2>Toolkit</h2>
        <p>What I reach for when building a study, an agent or a system.</p>
      </header>
      <dl class="skills">
        {skills.map((s) => (<div><dt>{s.group}</dt><dd><ul>{s.items.map((i) => <li>{i}</li>)}</ul></dd></div>))}
      </dl>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact navy" data-scene="night">
    <div class="wrap">
      <h2>Let’s work together.</h2>
      <p>I’m open to research collaborations, research positions and engineering roles in AI, XR and human-computer interaction.</p>
      <ul class="clinks">
        {site.email && <li><a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a></li>}
        <li><a href={site.links.github} rel="noopener"><Icon name="github" />GitHub</a></li>
        <li><a href={site.links.linkedin} rel="noopener"><Icon name="external" />LinkedIn</a></li>
        <li><a href={site.links.orcid} rel="noopener"><Icon name="external" />ORCID</a></li>
        <li><a class="btn" href="/cv/">View CV</a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Index: category filter, plus a fold that keeps the long tail behind "And many more".
  // Without JS every project is listed and the fold button stays hidden.
  const rows = [...document.querySelectorAll<HTMLElement>('.index > li[data-cats]')];
  const bar = document.querySelector<HTMLElement>('.filters');
  const showAll = document.querySelector<HTMLButtonElement>('.show-all');
  const empty = document.querySelector<HTMLElement>('.empty')!;
  let cat = 'all', open = false;
  const apply = () => {
    let shown = 0;
    rows.forEach((r) => {
      const hit = cat === 'all' || r.dataset.cats!.split('|').includes(cat);
      const tucked = !open && cat === 'all' && r.dataset.fold !== undefined;
      r.hidden = !hit || tucked; if (hit) shown++;
    });
    if (showAll) showAll.hidden = open || cat !== 'all';
    empty.hidden = shown > 0;
  };
  showAll?.addEventListener('click', () => { open = true; apply(); });
  if (bar) {
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      cat = btn.dataset.cat!;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply();
    });
  }
  apply();
</script>

<style>
  /* Hero: the sky field owns the first viewport; name low and large, facts on the base line */
  .hero { min-height: min(54rem, 96svh); display: grid; align-items: end; padding-block: calc(var(--nav-h) + 4rem) clamp(2.5rem, 6vh, 4rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 3rem; align-items: end; }
  .hero h1 { grid-column: 1 / -1; font: 600 clamp(3.6rem, 10.5vw, 6rem)/.95 var(--sans); letter-spacing: -0.04em; margin-bottom: 1.75rem; }
  .hero-lines { grid-column: 1; list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; font-size: clamp(1.1rem, 1.7vw, 1.25rem); line-height: 1.45; color: var(--ink-2); }
  .hero-lines li:first-child { font-size: clamp(1.3rem, 2.4vw, 1.6rem); color: var(--ink); letter-spacing: -0.015em; margin-bottom: .2rem; }
  .hero-lede { grid-column: 1; font-size: clamp(1.15rem, 1.9vw, 1.3rem); color: var(--ink); max-width: 44ch; line-height: 1.5; margin-top: 1.5rem; }
  .hero-actions { grid-column: 2; grid-row: 2 / span 2; display: flex; flex-wrap: wrap; gap: .75rem; justify-content: flex-end; }
  .hero-facts { grid-column: 1 / -1; position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 2.5rem; margin: clamp(2.5rem, 6vh, 4rem) 0 0; padding-top: 1.4rem; border-top: 1px solid var(--rule); }
  .hero-facts::before { content: ''; position: absolute; left: 0; top: -2px; width: 9rem; height: 3px; background: var(--bg); }
  .hero-facts dt { font-size: .95rem; font-weight: 600; color: var(--ink-3); }
  .hero-facts dd { margin: .2rem 0 0; color: var(--ink); font-weight: 500; line-height: 1.45; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-actions { grid-column: 1; grid-row: auto; justify-content: flex-start; margin-top: 1.75rem; }
    .hero-facts { grid-template-columns: 1fr; }
  }

  /* Masters: the one navy block in the body of the page. One project, shown as its two halves. */
  .masters { display: grid; gap: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: clamp(3.5rem, 7vw, 5rem); padding: clamp(1.25rem, 3vw, 2.5rem); border-radius: var(--r-l); box-shadow: var(--shadow); }
  .masters-intro { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: 1rem 3rem; align-items: baseline; }
  .masters-label { display: inline-flex; align-items: center; gap: .7rem; font: 600 1.5rem/1.2 var(--sans); }
  .masters-text { display: grid; gap: clamp(1.25rem, 2.5vw, 1.75rem); }
  .masters-title { font: 600 clamp(1.75rem, 3.2vw, 2.6rem)/1.1 var(--sans); letter-spacing: -0.035em; color: var(--ink); max-width: 26ch; text-wrap: balance; }
  .masters-meta { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, auto)); justify-content: start; gap: 1rem clamp(2rem, 5vw, 4rem); }
  .masters-meta dt { font-size: .9rem; font-weight: 600; color: var(--ink-3); }
  .masters-meta dd { margin: .2rem 0 0; color: var(--ink); line-height: 1.5; }
  .parts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.75rem, 3.5vw, 3rem); padding-top: clamp(1.5rem, 3vw, 2.25rem); border-top: 1px solid var(--rule); }
  .feature { display: grid; grid-template-rows: auto 1fr; gap: 1.35rem; text-decoration: none; color: inherit; }
  .feature:hover { color: inherit; }
  .feature .media { aspect-ratio: 16 / 10; border-radius: var(--r-m); }
  .feature .media img { object-position: top; }
  .feature:hover .media img { transform: scale(1.03); }
  .feature-body { display: grid; align-content: start; justify-items: start; gap: .7rem; }
  .feature-body h4 { font: 600 clamp(1.5rem, 2.4vw, 1.9rem)/1.15 var(--sans); letter-spacing: -0.025em; }
  .feature-body p { max-width: 46ch; }
  .feature-body .part-line { color: var(--ink); font-weight: 500; font-size: 1.15rem; line-height: 1.4; }
  .read { display: inline-flex; gap: .5rem; align-items: center; margin-top: .5rem; color: var(--amber); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .25em; transition: color .2s; }
  .read :global(svg) { width: 1.05em; transition: transform .3s var(--ease); }
  .feature:hover .read { color: var(--amber-hot); text-decoration-thickness: 2px; }
  .feature:hover .read :global(svg) { transform: translateX(4px); }
  @media (max-width: 860px) {
    .masters-intro, .parts { grid-template-columns: 1fr; }
    .masters-meta { grid-template-columns: 1fr; }
  }

  /* Media + placeholders */
  .media { position: relative; overflow: hidden; background: var(--sky-wash); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .ph { position: absolute; inset: 0; padding: 1.25rem; display: grid; align-content: end; justify-items: start; gap: .6rem; }
  .ph p { color: var(--bg-raised); font-size: .95rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* Filters */
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.75rem; }
  .filters button {
    font: 500 .98rem/1 var(--sans); color: var(--ink); background: var(--surface); cursor: pointer; min-height: 2.6rem;
    border: 0; box-shadow: inset 0 0 0 1px var(--rule); border-radius: 999px; padding: .6rem 1.05rem; transition: color .2s, box-shadow .2s, background .2s;
  }
  .filters button:hover { background: var(--sky-wash); box-shadow: inset 0 0 0 1px var(--sky-dim); }
  .filters button[aria-pressed='true'] { color: var(--white); background: var(--bg); box-shadow: none; }

  /* Project index: one ruled list. Spotlight rows open up with a large image and a paragraph;
     the rest keep the same anatomy (year, title, summary, image) at row scale. */
  .index { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule-strong); }
  .index > li { border-bottom: 1px solid var(--rule); }
  .row {
    display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.3fr) 8.5rem; column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: start; padding: 1.2rem .5rem; text-decoration: none; color: inherit; transition: background .2s;
  }
  .row:hover { color: inherit; background: var(--sky-wash); }
  .row h3 { font: 650 1.3rem/1.3 var(--sans); letter-spacing: -0.01em; text-wrap: balance; }
  .row:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .2em; text-decoration-color: var(--amber); }
  .row-main { display: grid; gap: .6rem; align-content: start; justify-items: start; }
  .row-sum { color: var(--ink-2); font-size: 1.02rem; line-height: 1.55; padding-top: .15rem; }
  .yr { color: var(--ink-3); font-size: .9rem; line-height: 1.3; padding-top: .42rem; }
  .row .media { aspect-ratio: 16 / 10; border-radius: var(--r-s); }
  .row .media::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgb(11 22 38 / .14); pointer-events: none; }
  .row:hover .media img { transform: scale(1.05); }
  .row .ph { padding: .5rem; }
  .row .ph p { display: none; }

  .lead .row { grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.25fr); padding-block: clamp(2rem, 4.5vw, 3.25rem); }
  .lead .row:hover { background: none; }
  .lead h3 { font: 600 clamp(1.8rem, 3vw, 2.4rem)/1.12 var(--sans); letter-spacing: -0.03em; }
  .lead .yr { padding-top: clamp(.75rem, 1.4vw, 1.15rem); }
  .lead .row-main { gap: 1rem; padding-block: .2rem .5rem; }
  .lead .row-sum { font-size: 1.125rem; line-height: 1.6; padding-top: 0; max-width: 46ch; }
  .lead .media { margin-left: clamp(0rem, 2vw, 1.5rem); border-radius: var(--r-m); box-shadow: var(--shadow); transition: box-shadow .4s var(--ease), transform .5s var(--ease); }
  .lead .row:hover .media { box-shadow: var(--shadow-xl); transform: translateY(-4px); }
  .lead .row:hover .media img { transform: scale(1.03); }
  .lead .ph { padding: 1.25rem; }
  .lead .ph p { display: -webkit-box; }
  .row-meta { margin: .2rem 0 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: .7rem 2rem; justify-self: stretch; }
  .row-meta dt { font-size: .9rem; font-weight: 600; color: var(--ink-3); }
  .row-meta dd { margin: .15rem 0 0; color: var(--ink); font-size: 1rem; line-height: 1.45; }
  .more { display: inline-flex; align-items: center; gap: .5rem; margin-top: .3rem; font-weight: 600; color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .25em; }
  .more :global(svg) { width: 1.05em; transition: transform .3s var(--ease); }
  .lead .row:hover .more { color: var(--ink); text-decoration-thickness: 2px; }
  .lead .row:hover .more :global(svg) { transform: translateX(4px); }

  /* Closing row: same columns as a project row, no link of its own. */
  .index > .many { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.3fr) 8.5rem; column-gap: clamp(1.25rem, 2.5vw, 2.25rem); row-gap: 1rem; align-items: start; padding: clamp(1.75rem, 3.5vw, 2.5rem) .5rem; border-bottom: 0; }
  .many h3 { grid-column: 2; font: 600 clamp(1.8rem, 3vw, 2.4rem)/1.12 var(--sans); letter-spacing: -0.03em; }
  .many p { grid-column: 3 / -1; color: var(--ink-2); font-size: 1.125rem; line-height: 1.6; max-width: 46ch; padding-top: .35rem; }
  .many-actions { grid-column: 3 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .many-actions a { font-weight: 600; }
  .show-all[hidden] { display: none; }

  @media (max-width: 1040px) {
    .index > li:not(.lead) .row { grid-template-columns: 4.5rem minmax(0, 1fr) 8.5rem; grid-template-areas: 'yr main media' 'yr sum media'; row-gap: .45rem; }
    .index > li:not(.lead) .yr { grid-area: yr; }
    .index > li:not(.lead) .row-main { grid-area: main; }
    .index > li:not(.lead) .row-sum { grid-area: sum; }
    .index > li:not(.lead) .media { grid-area: media; }
    .index > .many { grid-template-columns: 4.5rem minmax(0, 1fr); }
    .many h3, .many p, .many-actions { grid-column: 2; }
  }
  @media (max-width: 940px) {
