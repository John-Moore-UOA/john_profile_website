---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cats from '../components/Cats.astro';
import { site, experience, education, skills, publications } from '../data/site';
import { CATEGORIES } from '../content.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const masters = projects.find((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const usedCats = CATEGORIES.filter((c) => rest.some((p) => p.data.categories.includes(c)));

const AREAS = ['Computer Science', 'Software Engineering', 'Computer Systems', 'General Engineering'] as const;
const courses = await getCollection('courses');
const byArea = AREAS.map((area) => ({
  area,
  items: courses.filter((c) => c.data.area === area)
    .sort((a, b) => Number(b.data.highlight) - Number(a.data.highlight) || b.data.code.localeCompare(a.data.code)),
})).filter((g) => g.items.length);
---
<Base>
  <!-- Hero -->
  <section class="hero field">
    <div class="wrap hero-grid">
      <h1>{site.name}</h1>
      <ul class="hero-lines">
        <li><strong>Master of Engineering candidate</strong>, Bioengineering</li>
        <li><a href={site.lab.url} rel="noopener">{site.lab.name}</a>, <a href={site.abi.url} rel="noopener">{site.abi.name}</a></li>
        <li>BE(Hons) First Class, Software Engineering, {site.uni}</li>
      </ul>
      <p class="hero-lede">{site.lede}</p>
      <div class="hero-actions">
        <a class="btn" href="#projects">See current projects <Icon name="arrow" /></a>
        <a class="btn ghost" href="/cv/">View CV</a>
      </div>
      <dl class="hero-facts">
        <div><dt>Focus</dt><dd>AI agents · Empathic AI · Physiological sensing</dd></div>
        <div><dt>Open to</dt><dd>Research &amp; engineering roles in AI, XR and HCI</dd></div>
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="wrap">
      <header class="sec-head">
        <h2>Current projects</h2>
        <p>Research systems, study tools and side projects. Each one opens a design log with process notes, figures and outcomes.</p>
      </header>

      {masters && (
        <article class="masters navy">
          <div class="masters-intro">
            <h3 class="masters-label">Masters project</h3>
            <p>
              A one-year Master of Engineering in Bioengineering ({site.masters.when}) at the
              {' '}<a href={site.abi.url} rel="noopener">{site.abi.name}</a>, within the
              {' '}<a href={site.lab.url} rel="noopener">{site.lab.name}</a>.
            </p>
          </div>
          <a class="feature" href={`/projects/${masters.id}/`}>
            <div class="media">
              {masters.data.image
                ? <img src={masters.data.image} alt={masters.data.cover ?? ''} />
                : <div class="ph slot-field" aria-hidden="true"><span class="slot-tag">Image to come</span><p>{masters.data.cover}</p></div>}
            </div>
            <div class="feature-body">
              <Cats list={masters.data.categories} />
              <h4>{masters.data.title}</h4>
              <p>{masters.data.summary}</p>
              <span class="read">Read the design log <Icon name="arrow" /></span>
            </div>
          </a>
        </article>
      )}

      <div class="filters" role="group" aria-label="Filter projects by area" hidden>
        <button type="button" aria-pressed="true" data-cat="all">All</button>
        {usedCats.map((c) => <button type="button" aria-pressed="false" data-cat={c} data-c={c}>{c}</button>)}
      </div>

      <div class="carousel">
      <div class="viewport"><div class="track">
      <ul class="grid">
        {rest.map((p) => (
          <li data-cats={p.data.categories.join('|')}>
            <a class="card" href={`/projects/${p.id}/`}>
              <div class="media">
                {p.data.image
                  ? <img src={p.data.image} alt={p.data.cover ?? ''} loading="lazy" />
                  : <div class="ph slot-field" aria-hidden="true"><span class="slot-tag">Image to come</span><p>{p.data.cover}</p></div>}
              </div>
              <div class="card-body">
                <Cats list={p.data.categories} />
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
                <span class="mono yr">{p.data.year}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      </div></div>
      <nav class="pager" aria-label="Project pages" hidden>
        <button type="button" class="prev" aria-label="Previous projects">&larr;</button>
        <span class="dots"></span>
        <button type="button" class="next" aria-label="Next projects">&rarr;</button>
      </nav>
      </div>
      <p class="empty" hidden>No projects in this area yet.</p>
    </div>
  </section>

  <!-- Publications -->
  <section id="publications">
    <div class="wrap">
      <header class="sec-head"><h2>Publications</h2></header>
      <ol class="pubs">
        {publications.map((p) => (
          <li>
            <span class="mono pyear">{p.year}</span>
            <div>
              <h3><a href={p.url} rel="noopener">{p.title}</a></h3>
              <p class="venue">{p.venue} · {p.type}</p>
              <p class="authors">{p.authors.split(', ').map((a, i, arr) => <>{a === site.name ? <strong>{a}</strong> : a}{i < arr.length - 1 && ', '}</>)}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Courses -->
  <section id="courses">
    <div class="wrap">
      <header class="sec-head">
        <h2>Courses</h2>
        <p>Selected courses from my <strong>BE(Hons) in Software Engineering</strong> at the {site.uni} (2022 – 2025, First Class Honours). Open one to see what I built and how it connects to my research.</p>
      </header>
      <div class="areas">
        {byArea.map((g) => (
          <div class="area">
            <h3>{g.area}</h3>
            <ul>
              {g.items.map((c) => (
                <li>
                  <a href={`/courses/${c.id}/`}>
                    <span class="mono code">{c.data.code}</span>
                    <span class="cname">{c.data.name}</span>
                    <span class="mono term">{c.data.term}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="band">
    <div class="wrap">
      <header class="sec-head"><h2>Experience &amp; education</h2></header>
      <div class="xp-grid">
        <ol class="xp">
          {experience.map((x) => (
            <li>
              <p class="when">{x.when}</p>
              <h3>{x.title}</h3>
              <p class="org">{x.url ? <a href={x.url} rel="noopener">{x.org}</a> : x.org}</p>
              <p class="note">{x.note}</p>
            </li>
          ))}
        </ol>
        <div class="edu">
          <h3 class="col-title">Education</h3>
          {education.map((e) => (
            <div>
              <p class="when">{e.when}</p>
              <h4>{e.title}</h4>
              <p class="org">{e.org}</p>
              {e.note && <p class="note">{e.note}</p>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Toolkit (replaces About) -->
  <section id="toolkit">
    <div class="wrap">
      <header class="sec-head">
        <h2>Toolkit</h2>
        <p>What I reach for when building a study, an agent or a system.</p>
      </header>
      <dl class="skills">
        {skills.map((s) => (<div><dt>{s.group}</dt><dd><ul>{s.items.map((i) => <li>{i}</li>)}</ul></dd></div>))}
      </dl>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact navy">
    <div class="wrap">
      <h2>Let’s work together.</h2>
      <p>I’m open to research collaborations, research positions and engineering roles in AI, XR and human-computer interaction.</p>
      <ul class="clinks">
        {site.email && <li><a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a></li>}
        <li><a href={site.links.github} rel="noopener"><Icon name="github" />GitHub</a></li>
        <li><a href={site.links.linkedin} rel="noopener"><Icon name="external" />LinkedIn</a></li>
        <li><a href={site.links.orcid} rel="noopener"><Icon name="external" />ORCID</a></li>
        <li><a class="btn" href="/cv/">View CV</a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Carousel: chunk the visible cards into pages of 8 (4 x 2) that slide horizontally.
  const PER = 8;
  const track = document.querySelector<HTMLElement>('.track')!;
  const pager = document.querySelector<HTMLElement>('.pager')!;
  const dots = pager.querySelector<HTMLElement>('.dots')!;
  const allRows = [...document.querySelectorAll<HTMLElement>('.grid > li')];
  // Clone the server-rendered list so new pages keep Astro's scoped-style attribute.
  const template = track.querySelector<HTMLElement>('.grid')!.cloneNode(false) as HTMLElement;
  let page = 0, pages = 1;
  const go = (n: number) => {
    page = Math.max(0, Math.min(pages - 1, n));
    track.style.transform = `translateX(-${page * 100}%)`;
    dots.querySelectorAll('button').forEach((d, i) => d.setAttribute('aria-current', String(i === page)));
    pager.querySelector<HTMLButtonElement>('.prev')!.disabled = page === 0;
    pager.querySelector<HTMLButtonElement>('.next')!.disabled = page === pages - 1;
    track.querySelectorAll<HTMLElement>('.grid').forEach((g, i) => g.inert = i !== page);
  };
  const layout = () => {
    const vis = allRows.filter((r) => !r.hidden);
    track.replaceChildren();
    for (let i = 0; i < Math.max(vis.length, 1); i += PER) {
      const ul = template.cloneNode(false) as HTMLElement;
      vis.slice(i, i + PER).forEach((r) => ul.append(r));
      track.append(ul);
    }
    allRows.filter((r) => r.hidden).forEach((r) => track.lastElementChild!.append(r));
    pages = track.children.length;
    dots.replaceChildren(...Array.from({ length: pages }, (_, i) => {
      const b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', `Page ${i + 1}`);
      b.onclick = () => go(i); return b;
    }));
    pager.hidden = pages < 2;
    go(0);
  };
  pager.querySelector('.prev')!.addEventListener('click', () => go(page - 1));
  pager.querySelector('.next')!.addEventListener('click', () => go(page + 1));
  document.querySelector('.carousel')!.classList.add('on');
  layout();

  const bar = document.querySelector<HTMLElement>('.filters');
  if (bar) {
    bar.hidden = false;
    const rows = allRows;
    const empty = document.querySelector<HTMLElement>('.empty')!;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const cat = btn.dataset.cat!;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      rows.forEach((r) => {
        const hit = cat === 'all' || r.dataset.cats!.split('|').includes(cat);
        r.hidden = !hit; if (hit) shown++;
      });
      empty.hidden = shown > 0;
      layout();
    });
  }
</script>

<style>
  /* Hero: the sky field owns the first viewport; name low and large, facts on the base line */
  .hero { min-height: min(54rem, 96svh); display: grid; align-items: end; padding-block: calc(var(--nav-h) + 4rem) clamp(2.5rem, 6vh, 4rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 3rem; align-items: end; }
  .hero h1 { grid-column: 1 / -1; font: 600 clamp(3.6rem, 10.5vw, 6rem)/.95 var(--sans); letter-spacing: -0.04em; margin-bottom: 1.75rem; }
  .hero-lines { grid-column: 1; list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; font-size: clamp(1.1rem, 1.7vw, 1.25rem); line-height: 1.45; color: var(--ink-2); }
  .hero-lines li:first-child { font-size: clamp(1.3rem, 2.4vw, 1.6rem); color: var(--ink); letter-spacing: -0.015em; margin-bottom: .2rem; }
  .hero-lede { grid-column: 1; font-size: clamp(1.15rem, 1.9vw, 1.3rem); color: var(--ink); max-width: 44ch; line-height: 1.5; margin-top: 1.5rem; }
  .hero-actions { grid-column: 2; grid-row: 2 / span 2; display: flex; flex-wrap: wrap; gap: .75rem; justify-content: flex-end; }
  .hero-facts { grid-column: 1 / -1; position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 2.5rem; margin: clamp(2.5rem, 6vh, 4rem) 0 0; padding-top: 1.4rem; border-top: 1px solid var(--rule); }
  .hero-facts::before { content: ''; position: absolute; left: 0; top: -2px; width: 9rem; height: 3px; background: var(--bg); }
  .hero-facts dt { font-size: .95rem; font-weight: 600; color: var(--ink-3); }
  .hero-facts dd { margin: .2rem 0 0; color: var(--ink); font-weight: 500; line-height: 1.45; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-actions { grid-column: 1; grid-row: auto; justify-content: flex-start; margin-top: 1.75rem; }
    .hero-facts { grid-template-columns: 1fr; }
  }

  /* Masters: the one navy block in the body of the page */
  .masters { display: grid; gap: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: clamp(3.5rem, 7vw, 5rem); padding: clamp(1.25rem, 3vw, 2.5rem); border-radius: var(--r-l); box-shadow: var(--shadow); }
  .masters-intro { display: grid; grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); gap: .6rem 3rem; align-items: baseline; }
  .masters-label { display: inline-flex; align-items: center; gap: .7rem; font: 600 1.5rem/1.2 var(--sans); }
  .masters-label::before { content: ''; width: .8rem; height: .8rem; border-radius: 3px; background: var(--amber); flex: none; }
  .masters-intro p { max-width: 62ch; }
  .feature { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(1.5rem, 3vw, 2.75rem); text-decoration: none; color: inherit; padding-top: clamp(1.5rem, 3vw, 2.25rem); border-top: 1px solid var(--rule); }
  .feature:hover { color: inherit; }
  .feature .media { min-height: 23rem; border-radius: var(--r-m); }
  .feature-body { display: grid; align-content: center; gap: 1.1rem; padding-block: .5rem; }
  .feature-body h4 { font: 600 clamp(1.8rem, 3vw, 2.4rem)/1.12 var(--sans); letter-spacing: -0.03em; }
  .read { justify-self: start; display: inline-flex; gap: .55rem; align-items: center; min-height: 2.85rem; padding: .7rem 1.3rem; border-radius: 999px; background: var(--amber); color: var(--bg); font-weight: 600; line-height: 1; margin-top: .4rem; transition: background .2s; }
  .read :global(svg) { width: 1.05em; transition: transform .3s var(--ease); }
  .feature:hover .read { background: var(--amber-hot); }
  .feature:hover .read :global(svg) { transform: translateX(4px); }
  @media (max-width: 860px) {
    .masters-intro, .feature { grid-template-columns: 1fr; }
    .feature .media { min-height: 14rem; }
  }

  /* Media + placeholders */
  .media { position: relative; overflow: hidden; background: var(--sky-wash); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .ph { position: absolute; inset: 0; padding: 1.25rem; display: grid; align-content: end; justify-items: start; gap: .6rem; }
  .ph p { color: var(--bg-raised); font-size: .95rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* Filters */
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.75rem; }
  .filters button {
    font: 500 .98rem/1 var(--sans); color: var(--ink); background: var(--surface); cursor: pointer; min-height: 2.6rem;
    border: 0; box-shadow: inset 0 0 0 1px var(--rule); border-radius: 999px; padding: .6rem 1.05rem; transition: color .2s, box-shadow .2s, background .2s;
  }
  .filters button:hover { background: var(--sky-wash); box-shadow: inset 0 0 0 1px var(--sky-dim); }
  .filters button[aria-pressed='true'] { color: var(--white); background: var(--bg); box-shadow: none; }

  /* Project grid */
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); gap: clamp(1.25rem, 2.5vw, 2rem); }
  .card {
    height: 100%; display: grid; grid-template-rows: auto 1fr; text-decoration: none; color: inherit;
    background: var(--surface); border-radius: var(--r-m); overflow: hidden; box-shadow: inset 0 0 0 1px var(--rule), var(--shadow-s);
    transition: transform .4s var(--ease), box-shadow .3s;
  }
  .card:hover { transform: translateY(-3px); box-shadow: inset 0 0 0 1px var(--sky-dim), var(--shadow); color: inherit; }
  .card:hover .media img { transform: scale(1.03); }
  .card .media { aspect-ratio: 16 / 10; }
  .card-body { padding: 1.35rem 1.5rem 1.5rem; display: grid; gap: .7rem; align-content: start; grid-template-rows: auto auto 1fr auto; }
  .card-body h3 { font: 650 1.35rem/1.25 var(--sans); }
  .card:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .2em; text-decoration-color: var(--amber); }
  .card-body p { color: var(--ink-2); font-size: 1.02rem; line-height: 1.55; }
  .yr { color: var(--ink-3); font-size: .9rem; margin-top: .3rem; }
  .empty { color: var(--ink-3); padding: 1.5rem 0; }

  /* Carousel */
  .carousel.on .viewport { overflow: hidden; margin: -6px; padding: 6px; }
  .carousel.on .track { display: flex; transition: transform .6s var(--ease); }
  .carousel.on .track > .grid { flex: 0 0 100%; min-width: 0; grid-template-columns: repeat(4, minmax(0, 1fr)); align-content: start; padding-inline: 6px; }
  @media (max-width: 1100px) { .carousel.on .track > .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .carousel.on .track > .grid { grid-template-columns: 1fr; } }
  .carousel.on .card-body h3 { font-size: 1.15rem; }
  .carousel.on .card-body p { font-size: .95rem; }
  .pager { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.75rem; }
  .pager[hidden] { display: none; }
  .pager > button { width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 0; cursor: pointer; font-size: 1.1rem; color: var(--ink); background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule); }
  .pager > button:hover:not(:disabled) { background: var(--sky-wash); }
  .pager > button:disabled { opacity: .35; cursor: default; }
  .dots { display: flex; gap: .5rem; }
  .dots :global(button) { width: .7rem; height: .7rem; padding: 0; border: 0; border-radius: 999px; cursor: pointer; background: var(--rule-strong); }
  .dots :global(button[aria-current='true']) { background: var(--amber); width: 1.8rem; }
  @media (prefers-reduced-motion: reduce) { .carousel.on .track { transition: none; } }

  /* Publications: set on solid sky, the second appearance of the secondary colour */
  .pubs {
    --ink-2: var(--bg-raised); --ink-3: var(--line); --rule: rgb(11 22 38 / .25);
    list-style: none; margin: 0; padding: clamp(.5rem, 1.5vw, 1rem) clamp(1.25rem, 3.5vw, 3rem); border-radius: var(--r-l);
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / .14) 0 1px, transparent 1px 9px, rgb(11 22 38 / .03) 9px 10px, transparent 10px 20px), var(--sky);
  }
  .pubs li { display: grid; grid-template-columns: 6rem 1fr; gap: 2rem; padding: clamp(1.5rem, 3vw, 2.25rem) 0; }
  .pubs li + li { border-top: 1px solid var(--rule); }
  .pyear { color: var(--ink); font-size: 1.05rem; font-weight: 500; padding-top: .35rem; }
  .pubs h3 { font: 600 clamp(1.4rem, 2.6vw, 1.9rem)/1.2 var(--sans); letter-spacing: -0.025em; max-width: 30ch; }
  .pubs h3 a { color: var(--ink); text-decoration-color: rgb(11 22 38 / .4); }
  .pubs h3 a:hover { text-decoration-color: var(--bg); }
  .venue { margin-top: .7rem; color: var(--ink); font-weight: 500; }
  .authors { margin-top: .3rem; color: var(--ink-2); font-size: 1rem; max-width: 70ch; }
  .authors strong { font-weight: 700; }
  @media (max-width: 560px) { .pubs li { grid-template-columns: 1fr; gap: .4rem; } }

  /* Courses */
  .areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr)); gap: 3rem 3.5rem; }
  .area h3 { font: 650 1.2rem/1.3 var(--sans); padding: .9rem 0 .8rem; border-top: 2px solid var(--rule-strong); border-bottom: 1px solid var(--rule); letter-spacing: -0.01em; }
  .area ul { list-style: none; margin: 0; padding: 0; }
  .area a {
    display: grid; grid-template-columns: 8.5rem 1fr auto; gap: 1rem; align-items: baseline;
    padding: .85rem .6rem; margin-inline: -.6rem; border-radius: var(--r-s); text-decoration: none; color: var(--ink);
    transition: background .2s;
  }
  .area li + li { border-top: 1px solid var(--rule); }
  .area a:hover { background: var(--sky-wash); }
  .area a:hover .cname { text-decoration: underline; text-decoration-thickness: 1px; }
  .code { color: var(--sky-ink); font-size: .92rem; font-weight: 500; }
  .term { color: var(--ink-3); font-size: .85rem; white-space: nowrap; }
  @media (max-width: 520px) { .area a { grid-template-columns: 1fr; gap: .15rem; } }

  /* Experience */
  .xp-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }
  .xp { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule-strong); }
  .xp li { padding: 1.5rem 0; display: grid; grid-template-columns: 10.5rem minmax(0, 1fr); column-gap: 1.5rem; row-gap: .15rem; }
  .xp li + li { border-top: 1px solid var(--rule); }
  .xp li > :not(.when) { grid-column: 2; }
  .xp .when { grid-column: 1; grid-row: 1 / span 3; padding-top: .2rem; }
  .when { color: var(--ink-3); font-size: .98rem; font-variant-numeric: tabular-nums; }
  .xp h3, .edu h4 { font: 650 1.25rem/1.35 var(--sans); letter-spacing: -0.015em; }
  .org { color: var(--ink); font-weight: 500; }
  .note { color: var(--ink-2); margin-top: .4rem; font-size: 1.02rem; line-height: 1.6; max-width: 62ch; }
